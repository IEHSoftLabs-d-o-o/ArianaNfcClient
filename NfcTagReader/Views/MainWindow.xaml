<Window x:Class="NfcTagReader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NfcTagReader.Views"
        mc:Ignorable="d"
        Title="NFC Tag Reader – ArianaLab"
        Height="640"
        Width="880"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#15202B">
    <Window.Resources>
        <views:StatusKindToBrushConverter x:Key="StatusBrush" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EEF4" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock Text="NFC Tag Reader"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="Auftragserzeugung für ArianaLab"
                           Margin="0,4,0,0"
                           Foreground="#9BB0C3"
                           FontSize="14" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="Leser"
                           Foreground="#9BB0C3"
                           FontSize="11" />
                <TextBlock Text="{Binding ReaderName}"
                           FontSize="13" />
                <TextBlock Text="UID"
                           Margin="0,8,0,0"
                           Foreground="#9BB0C3"
                           FontSize="11" />
                <TextBlock Text="{Binding LastUid}"
                           FontFamily="Consolas"
                           FontSize="13" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2"
                Background="{Binding StatusKind, Converter={StaticResource StatusBrush}}"
                CornerRadius="8"
                Padding="18,14">
            <StackPanel>
                <TextBlock Text="{Binding Status}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResultMessage}"
                           Margin="0,6,0,0"
                           FontSize="14"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#1E2C3A"
                    CornerRadius="8"
                    Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Tag-JSON"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding PayloadPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#111A22"
                             Foreground="#D7E3EE"
                             BorderThickness="0"
                             Padding="10" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#1E2C3A"
                    CornerRadius="8"
                    Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Technical details"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#111A22"
                             Foreground="#D7E3EE"
                             BorderThickness="0"
                             Padding="10" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="6"
                   Text="Kein Lese-, Schreib- oder Lösch-Button. Das Programm wartet automatisch auf das nächste Tag."
                   Foreground="#7F93A6"
                   FontSize="12"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
