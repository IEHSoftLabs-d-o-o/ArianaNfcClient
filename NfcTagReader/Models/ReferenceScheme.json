{
  "type": "object",
  "required": [
    "Format",
    "Version",
    "Protokoll",
    "Probenehmer",
    "Kunde",
    "Gesundheitsamt",
    "Auftragsvorlage",
    "Entnahme",
    "Beschaffenheit",
    "Analysen",
    "Bericht"
  ],
  "properties": {
    "Format": { "type": "string" },
    "Version": { "type": "integer" },
    "Protokoll": {
      "type": "object",
      "required": ["Id", "Erstellt"],
      "properties": {
        "Id": { "type": "string" },
        "Erstellt": { "type": "string" }
      }
    },
    "Probenehmer": {
      "type": "object",
      "required": ["Bezeichnung"],
      "properties": {
        "Bezeichnung": { "type": "string" }
      }
    },
    "Kunde": {
      "type": "object",
      "required": ["Nummer", "Name"],
      "properties": {
        "Nummer": { "type": "string" },
        "Name": { "type": "string" }
      }
    },
    "Gesundheitsamt": {
      "type": "object",
      "required": ["Kurzname", "TeisKreisNummer", "Weitergabe"],
      "properties": {
        "Kurzname": { "type": "string" },
        "TeisKreisNummer": { "type": "string" },
        "Weitergabe": { "type": "string" }
      }
    },
    "Auftragsvorlage": {
      "type": "object",
      "required": ["Name"],
      "properties": {
        "Name": { "type": "string" }
      }
    },
    "Entnahme": {
      "type": "object",
      "required": ["Zeitpunkt", "Wassertyp", "Aufbereitung", "Stelle"],
      "properties": {
        "Zeitpunkt": { "type": "string" },
        "Wassertyp": { "type": "string" },
        "Aufbereitung": { "type": "string" },
        "Stelle": { "type": "string" }
      }
    },
    "Beschaffenheit": {
      "type": "object",
      "required": ["Klarheit", "Färbung", "Geruch", "Temperatur"],
      "properties": {
        "Klarheit": { "type": "string" },
        "Färbung": { "type": "string" },
        "Geruch": { "type": "string" },
        "Temperatur": { "type": "number" }
      }
    },
    "Analysen": {
      "type": "array",
      "items": { "type": "string" }
    },
    "Bericht": {
      "type": "object",
      "required": ["Bestätigen", "Probenahmegebuehr", "ProbenahmegebuehrUeberLabor", "UnterschriftDatum"],
      "properties": {
        "Bestätigen": { "type": "boolean" },
        "Probenahmegebuehr": { "type": "boolean" },
        "ProbenahmegebuehrUeberLabor": { "type": "boolean" },
        "UnterschriftDatum": { "type": "string" }
      }
    }
  }
}
