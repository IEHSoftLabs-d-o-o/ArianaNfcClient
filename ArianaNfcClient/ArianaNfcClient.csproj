<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>NFC Tag Reader – ArianaLab</ApplicationTitle>
    <ApplicationIcon>nfc.ico</ApplicationIcon>
    <RootNamespace>ArianaNfcClient</RootNamespace>
    <AssemblyName>ArianaNfcClient</AssemblyName>
    <Version>1.0.0.0</Version>
    <ProductName>Ariana NFC Client</ProductName>
    <PublisherName>Ariana Holding GmbH</PublisherName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishProfile)' == 'ClickOnce'">
    <PublishProtocol>ClickOnce</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>$(Version)</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>false</BootstrapperEnabled>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <PublishDir>bin\Release\net10.0-windows\win-x64\app.publish\</PublishDir>
    <ClickOncePublishDependsOn>SetGenerateManifests;GenerateManifests;_CopyManifestFiles</ClickOncePublishDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="NLog.Extensions.Hosting" Version="6.2.1" />
    <PackageReference Include="PCSC" Version="7.0.1" />
    <PackageReference Include="PCSC.Iso7816" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="nfc.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json;nlog.config" />
    <Content Include="appsettings.json;nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <EmbeddedResource Include="Models\ReferenceScheme.json" />
  </ItemGroup>

</Project>
