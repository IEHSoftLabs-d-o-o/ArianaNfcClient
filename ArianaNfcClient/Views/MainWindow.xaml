<Window x:Class="ArianaNfcClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ArianaNfcClient.Views"
        mc:Ignorable="d"
        Title="Ariana NFC Client"
        Icon="/nfc.ico"
        Height="640"
        Width="880"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Window.Resources>
        <views:StatusKindToBrushConverter x:Key="StatusBrush" />
        <ContextMenu x:Key="CopyableTextBoxMenu" x:Shared="False">
            <MenuItem Header="Kopieren" Click="CopyTextBoxMenuItem_OnClick" />
        </ContextMenu>
        <Style x:Key="CopyableTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ContextMenu" Value="{StaticResource CopyableTextBoxMenu}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CopyableTextBox_OnPreviewMouseLeftButtonDown" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#212529" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Width="36"
                    Height="36"
                    Margin="16,0,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    Cursor="Hand"
                    ToolTip="Einstellungen"
                    Click="SettingsButton_OnClick">
                <TextBlock Text="&#xE713;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="#2A3E91"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>
            <StackPanel>
                <TextBlock Text="Ariana NFC Client"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1B2A4A" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#495057"
                           FontSize="13">
                    <Run Text="ArianaLab: " />
                    <Run Text="{Binding BaseUrl, Mode=OneWay}" Foreground="#212529" />
                </TextBlock>
                <TextBlock Margin="0,2,0,0"
                           Foreground="#495057"
                           FontSize="13">
                    <Run Text="Benutzer: " />
                    <Run Text="{Binding Username, Mode=OneWay}" Foreground="#212529" />
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="Leser"
                           Foreground="#495057"
                           FontSize="11" />
                <TextBlock Text="{Binding ReaderName}"
                           FontSize="13" />
                <TextBlock Text="UID"
                           Margin="0,8,0,0"
                           Foreground="#495057"
                           FontSize="11" />
                <TextBlock Text="{Binding LastUid}"
                           FontFamily="Consolas"
                           FontSize="13" />
            </StackPanel>
        </DockPanel>

        <Border x:Name="StatusBanner"
                Grid.Row="2"
                Background="{Binding StatusKind, Converter={StaticResource StatusBrush}}"
                CornerRadius="8"
                SizeChanged="StatusBanner_OnSizeChanged">
            <Grid>
                <Rectangle x:Name="StatusSweep"
                           IsHitTestVisible="False"
                           Visibility="Collapsed">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="StatusSweepTransform" X="-1" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.3" />
                            <GradientStop Color="#80FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="0.7" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Margin="18,14">
                    <TextBlock Text="{Binding Status}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="{Binding ResultMessage}"
                               Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="White"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Tag-JSON"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding PayloadPreview, Mode=OneWay}"
                             Style="{StaticResource CopyableTextBox}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#FFFFFF"
                             Foreground="#212529"
                             BorderBrush="#DEE2E6"
                             BorderThickness="1"
                             Padding="10" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Technical details"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                             Style="{StaticResource CopyableTextBox}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#FFFFFF"
                             Foreground="#212529"
                             BorderBrush="#DEE2E6"
                             BorderThickness="1"
                             Padding="10" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="6"
                   Text=""
                   Foreground="#6C757D"
                   FontSize="12"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
