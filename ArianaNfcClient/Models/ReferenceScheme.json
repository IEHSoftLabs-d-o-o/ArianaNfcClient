{
  "type": "object",
  "required": [
    "Format",
    "Version",
    "Protokoll",
    "Kunde",
    "Gesundheitsamt",
    "Auftragsvorlage",
    "Entnahme",
    "Bericht"
  ],
  "properties": {
    "Format": { "type": "string" },
    "Version": { "type": "integer" },
    "Protokoll": {
      "type": "object",
      "required": ["Id", "Erstellt"],
      "properties": {
        "Id": { "type": "string" },
        "Erstellt": { "type": "string" }
      }
    },
    "Probenehmer": {
      "type": "object",
      "properties": {
        "Bezeichnung": { "type": "string" }
      }
    },
    "Kunde": {
      "type": "object",
      "required": ["Name"],
      "properties": {
        "Nummer": { "type": "string" },
        "Name": { "type": "string" }
      }
    },
    "Gesundheitsamt": {
      "type": "object",
      "required": ["Weitergabe"],
      "properties": {
        "Kurzname": { "type": "string" },
        "TeisKreisNummer": { "type": "string" },
        "Weitergabe": { "type": "string" }
      }
    },
    "Auftragsvorlage": {
      "type": "object",
      "required": ["Name"],
      "properties": {
        "Name": { "type": "string" }
      }
    },
    "Entnahme": {
      "type": "object",
      "required": ["Wassertyp", "Stelle"],
      "properties": {
        "Zeitpunkt": { "type": "string" },
        "Objekt": { "type": "string" },
        "ZidNr": { "type": "string" },
        "ArtDesWassers": { "type": "string" },
        "Wassertyp": { "type": "string" },
        "Aufbereitung": { "type": "string" },
        "Stelle": { "type": "string" }
      }
    },
    "Beschaffenheit": {
      "type": "object",
      "properties": {
        "Klarheit": { "type": "string" },
        "AnzahlProbenKlarheit": { "type": "integer" },
        "Faerbung": { "type": "string" },
        "Geruch": { "type": "string" },
        "Temperatur": { "type": "number" },
        "Sonstiges": { "type": "string" }
      }
    },
    "Flaschen": {
      "type": "object",
      "properties": {
        "Chemie": { "type": "integer" },
        "Mikrobiologie": { "type": "integer" },
        "PhLeitfaehigkeit": { "type": "integer" }
      }
    },
    "Analysen": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ExtraTexte": {
      "type": "object",
      "properties": {
        "Extra2": { "type": "string" },
        "Extra3": { "type": "string" },
        "Extra4": { "type": "string" }
      }
    },
    "Bericht": {
      "type": "object",
      "required": ["Probenahmegebuehr", "ProbenahmegebuehrUeberLabor"],
      "properties": {
        "An": { "type": "string" },
        "Kostentraeger": { "type": "string" },
        "Probenahmegebuehr": { "type": "boolean" },
        "ProbenahmegebuehrUeberLabor": { "type": "boolean" },
        "UnterschriftDatum": { "type": "string" }
      }
    },
    "Bemerkung": { "type": "string" }
  }
}
